FROM ubuntu:22.04

# Evitar preguntas interactivas durante la instalacion de paquetes
ENV DEBIAN_FRONTEND=noninteractive

# 1. Herramientas de compilacion y dependencias obligatorias
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    gcc \
    make \
    libreadline-dev \
    zlib1g-dev \
    bison \
    flex \
    libssl-dev \
    pkg-config \
    libicu-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2. Codigo fuente oficial de PostgreSQL
RUN git clone https://github.com/postgres/postgres.git

# 3. Compilar el motor desde el codigo fuente
WORKDIR /app/postgres
RUN ./configure --prefix=/usr/local/pgsql --without-icu
RUN make && make install

# 4. Usuario del sistema 'postgres'
RUN useradd -m postgres
RUN mkdir -p /usr/local/pgsql/data && chown -R postgres:postgres /usr/local/pgsql/data

# 5. Entorno del usuario postgres
USER postgres
ENV PATH="/usr/local/pgsql/bin:$PATH"

# 6. Inicializar el cluster con la contrasena '123'
RUN echo "123" > /tmp/pg_password && \
    initdb -D /usr/local/pgsql/data --pwfile=/tmp/pg_password && \
    rm /tmp/pg_password

# 7. Permitir conexiones desde la red bridge con autenticacion SCRAM-SHA-256
RUN echo "host all all all scram-sha-256" >> /usr/local/pgsql/data/pg_hba.conf
RUN echo "listen_addresses='*'" >> /usr/local/pgsql/data/postgresql.conf

EXPOSE 5432

# 8. Iniciar el demonio en primer plano
CMD ["postgres", "-D", "/usr/local/pgsql/data"]
