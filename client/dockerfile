FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# 1. Instalar herramientas básicas y dependencias de red
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    gcc \
    make \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2. Descargar el código fuente del cliente que te entregaron
# REEMPLAZA el link de abajo por el enlace del repositorio del CLIENTE que te dieron
RUN git clone https://github.com/dbcli/pgcli.git

# Nota técnica: Si el repositorio del cliente incluye un binario propio que requiere 
# ser compilado, descomenta las siguientes dos líneas borrando el '#' de abajo:
# RUN ./configure && make && make install

# 3. Configurar el contenedor para mantener la terminal abierta
CMD ["/bin/sh"]