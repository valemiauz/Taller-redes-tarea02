FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# 1. Herramientas basicas y el cliente psql
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    gcc \
    make \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2. Repositorio del cliente (referencia)
RUN git clone https://github.com/dbcli/pgcli.git

# 3. Mantener la terminal abierta
CMD ["/bin/sh"]
